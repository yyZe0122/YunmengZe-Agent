{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YunmengZe local agent configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subagent": {
          "type": "string"
        },
        "compact": {
          "type": "string"
        },
        "web": {
          "type": "string"
        },
        "vision": {
          "type": "string"
        },
        "memory": {
          "type": "string",
          "description": "Preference curation model; defaults to the current session model."
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocol": {
            "enum": [
              "openai-chat",
              "openai-responses",
              "anthropic-messages",
              "gemini-generate-content"
            ]
          },
          "type": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "baseURL": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "completionPath": {
                "type": "string"
              },
              "responseFormat": {
                "type": "string"
              },
              "anthropicVersion": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "baseURL"
            ]
          },
          "models": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "responseFormat": {
                  "enum": [
                    "auto",
                    "json_schema",
                    "json_object"
                  ]
                },
                "temperature": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "maxTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "contextWindow": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "context": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "reasoningEffort": {
                  "type": "string"
                },
                "supportsImages": {
                  "type": "boolean",
                  "description": "Explicit image-input capability; otherwise use exact catalog metadata."
                },
                "nativeCompaction": {
                  "type": "boolean",
                  "default": false,
                  "description": "Opt in to the Responses /compact endpoint when supported by this service and model."
                }
              }
            }
          }
        },
        "required": [
          "options"
        ]
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_inject_runes": {
              "anyOf": [
                {
                  "const": 0
                },
                {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 16000
                }
              ]
            },
            "default_ttl": {
              "type": "string"
            },
            "curator": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "max_facts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "timeout_ms": {
                  "anyOf": [
                    {
                      "const": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 120000
                    }
                  ]
                },
                "min_turns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64,
                  "default": 8
                },
                "min_interval": {
                  "type": "string",
                  "default": "30m",
                  "description": "Minimum interval between curation attempts, 1m..720h."
                }
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "template": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            },
            "required": [
              "template"
            ]
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "search": {
              "enum": [
                "ddg",
                "searxng",
                "tavily"
              ]
            },
            "searxng_url": {
              "type": "string"
            },
            "tavily_key": {
              "type": "string"
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "stdio",
                  "http",
                  "sse",
                  "remote"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "model",
    "provider"
  ]
}
