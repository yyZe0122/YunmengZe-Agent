{
  "$schema": "./agent.schema.json",
  "model": "deepseek1/deepseek-chat",
  "provider": {
    "deepseek1": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK1_API_KEY}"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat",
          "maxTokens": 4096,
          "supportsImages": false
        }
      }
    }
  },
  "chat": {
    "compaction": {
      "enabled": true
    },
    "skills": {
      "enabled": true
    },
    "vision": {
      "enabled": true
    },
    "task": {
      "enabled": true
    },
    "web": {
      "enabled": true,
      "search": "ddg"
    },
    "memory": {
      "enabled": true,
      "curator": {
        "enabled": true,
        "min_turns": 8,
        "min_interval": "30m"
      }
    }
  },
  "mcp": {
    "enabled": true,
    "servers": {}
  }
}
