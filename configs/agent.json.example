{
  "$schema": "./configs/agent.schema.json",
  "model": "deepseek1/deepseek-chat",
  "models": {
    "subagent": "deepseek1/deepseek-chat",
    "compact": "deepseek1/deepseek-chat",
    "web": "deepseek1/deepseek-chat"
  },
  "provider": {
    "deepseek1": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK1_API_KEY}"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat (official bare id)"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek Flash",
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    },
    "deepseek2": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://llm.example.com/v1",
        "apiKey": "{env:DEEPSEEK2_API_KEY}"
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "name": "Nested wire id (select deepseek2/deepseek/deepseek-v4-flash)"
        },
        "flash": {
          "name": "Short key + id override (select deepseek2/flash)",
          "id": "deepseek/deepseek-v4-flash"
        }
      }
    },
    "openai": {
      "type": "openai",
      "options": {
        "baseURL": "https://api.openai.com",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-model-id": {
          "name": "OpenAI Responses model",
          "reasoningEffort": "high"
        }
      }
    },
    "anthropic": {
      "type": "anthropic",
      "options": {
        "baseURL": "https://api.anthropic.com",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-model-id": {
          "name": "Claude model"
        }
      }
    },
    "google": {
      "type": "gemini",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com",
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-model-id": {
          "name": "Gemini model"
        }
      }
    },
    "literal-key-example": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.example.com",
        "apiKey": "sk-replace-with-your-key"
      },
      "models": {
        "demo": {
          "name": "Literal apiKey example (optional; prefer env or file)"
        }
      }
    },
    "file-key-example": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.example.com",
        "apiKey": "{file:secrets/demo.key}"
      },
      "models": {
        "demo": {
          "name": "File-ref apiKey example (path relative to config dir)"
        }
      }
    }
  },
  "chat": {
    "workspace": {
      "default": "client_cwd",
      "allow": [],
      "allow_all": false
    },
    "allow_write": true,
    "tools": {
      "git": false,
      "process": false
    },
    "compaction": { "enabled": true },
    "max_iterations": 0,
    "permission": { "mode": "preauth" },
    "memory": {
      "enabled": true,
      "max_inject_runes": 2000,
      "default_ttl": "",
      "session_search": true,
      "curator": { "enabled": true, "max_facts": 3, "timeout_ms": 15000 }
    },
    "skills": { "unused_ttl": "" },
    "commands": {
      "review": {
        "description": "Code review focus",
        "template": "Review with security and API design in mind.\n\n$ARGUMENTS"
      }
    },
    "web": {
      "search": "ddg"
    }
  }
}
