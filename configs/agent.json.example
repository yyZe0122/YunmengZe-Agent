{
  "$schema": "./agent.schema.json",
  "model": "deepseek1/deepseek-chat",
  "provider": {
    "deepseek1": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK1_API_KEY}"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat",
          "maxTokens": 4096,
          "supportsImages": false
        }
      }
    }
  },
  "chat": {
    "memory": {
      "curator": {
        "min_turns": 8,
        "min_interval": "30m"
      }
    }
  }
}
